{
  "name": "sleam",
  "productName": "Sleam",
  "version": "0.1.1",
  "description": "A Slack-style desktop client that uses Microsoft Teams as its backend",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "dev.sleam.app",
    "productName": "Sleam",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Sleam-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Sleam-${version}-${arch}.dmg"
    }
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.2",
    "dompurify": "^3.4.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
